# Rendered by .github/workflows/bump-tap.yml from a published ui-v* release.
cask "keber" do
  version "{{VERSION}}"
  sha256 "{{SHA}}"

  url "https://github.com/golobitch/keber/releases/download/ui-v#{version}/Keber-macos-universal.zip",
      verified: "github.com/golobitch/keber/"
  name "Keber"
  desc "Read-only browser for TigerBeetle clusters"
  homepage "https://golobitch.github.io/keber/"

  livecheck do
    url "https://github.com/golobitch/keber/releases"
    # Matches ui-v* only. :github_latest would follow whichever component released most recently,
    # and a cli release would quietly become the app's "new version".
    regex(/ui[._-]v?(\d+(?:\.\d+)+)/i)
    strategy :page_match
  end

  depends_on macos: :sequoia

  app "Keber.app"

  # The app is sandboxed, so its state lives in a container rather than loose in ~/Library. The
  # bundle id and folder keep the app's first name, tb-explorer, so the paths do too.
  zap trash: [
    "~/Library/Application Support/tb-explorer",
    "~/Library/Containers/com.golobitch.tb-explorer",
    "~/Library/Preferences/com.golobitch.tb-explorer.plist",
    "~/Library/Saved Application State/com.golobitch.tb-explorer.savedState",
  ]
end
